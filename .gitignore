/.vagrant

# Your machine configs, deploy keys, .env files, starter CLAUDE.md files and
# project context stay on your computer
/machines/*.json
/keys/*
!/keys/.gitkeep
/env/*
!/env/.gitkeep
/claude/*
!/claude/example.md.example
/context/*
!/context/.gitkeep

# Provisioning logs from the gup and gprov shortcuts: they include your machine's details
/logs/

.DS_Store