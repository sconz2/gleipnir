#!/usr/bin/env python3
"""Gleipnir: Heimdall, the change checks. Flags changes to the files it watches, the ones
that can make something run code: package scripts, tool and deploy configs, shell scripts,
Claude Code's own settings, anything marked runnable; npm and Composer package changes (in
every app's lock file); and git settings or hooks that run commands. It doesn't read the
project's ordinary source, which can run code too: that's what the diff is for.

In Claude's copy of the project it only reads files: it never runs git or anything
else there, so nothing Claude wrote runs because of it.

Claude Code hooks (set in the managed settings, run as the claude user):
  heimdall-check --hook-start     SessionStart: record a baseline
  heimdall-check --hook           Stop: report what changed since the last check

The claude command (runs as dev, outside Claude's reach), on Claude's copy:
  heimdall-check --snapshot FILE DIR
  heimdall-check --summary FILE DIR

gleipnir-review (runs as dev, in your own copy, after Claude's branch arrives): what the
branch itself changes, which is what you'd merge
  heimdall-check --review REPO BASE BRANCH
"""
import fnmatch
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import time

HEADER = "Heimdall: review these before merging Claude's work."
WORK = "/srv/work"

# Folders never scanned (dependencies, build output, git internals)
SKIP_DIRS = {"node_modules", "vendor", "storage", ".git", ".svelte-kit", "build", "dist", ".next", ".nuxt",
             ".output", ".vercel"}

# Files that can make something run code
SENSITIVE_NAMES = [
    "package.json", "package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml", "yarn.lock",
    ".npmrc", ".yarnrc", ".yarnrc.yml", ".envrc", "Makefile", "Vagrantfile", "*.sh",
    "*.config.js", "*.config.cjs", "*.config.mjs", "*.config.ts", "*.config.cts", "*.config.mts",
    ".eslintrc*", ".prettierrc*", ".babelrc*", ".gitattributes", ".gitmodules",
    # Claude Code's own project settings: MCP servers, hooks and commands
    ".mcp.json",
    # Task runners, git hook managers and workspaces
    "Taskfile.yml", "Taskfile.yaml", "justfile", "Justfile", ".pre-commit-config.yaml",
    "lefthook.yml", ".lefthook.yml", "turbo.json", "nx.json", "*.workspace.ts", "*.workspace.js",
    "*.workspace.mts", "*.workspace.mjs",
    # Containers and deploy settings, which say what to run elsewhere
    "Dockerfile", "Dockerfile.*", "*.Dockerfile", "docker-compose*.yml", "docker-compose*.yaml",
    "compose*.yml", "compose*.yaml", "Procfile", "netlify.toml", "vercel.json", "fly.toml",
    "render.yaml", "app.json",
    # PHP: Composer's packages, scripts, plugins and credentials, and tools that load PHP files
    "composer.json", "composer.lock", "auth.json", "artisan", "phpunit.xml", "phpunit.xml.dist",
    "phpstan.neon", "phpstan.neon.dist", "rector.php", ".php-cs-fixer.php", ".php-cs-fixer.dist.php",
]
# Lock files, whose packages are compared one by one
LOCK_FILES = {"package-lock.json", "composer.lock"}
# Every file inside these folders counts (editor tasks, IDE run configurations, git hook
# managers, Claude Code's settings, GitHub's workflows and actions)
SENSITIVE_DIRS = {".vscode", ".idea", ".husky", ".claude", ".github"}
# Files in .git (besides the hooks) that change what git does with the repo
GIT_EXTRAS = ["info/attributes", "info/exclude", "objects/info/alternates"]
# Changes constantly while you work
IGNORED_FILES = {os.path.join(".idea", "workspace.xml")}
# Git settings whose value is a command git will run (or that bring in more settings)
RISKY_GIT_CONFIG = re.compile(
    r"^(core\.(fsmonitor|hookspath|sshcommand|pager|editor|askpass|gitproxy)|diff\.external"
    r"|diff\..+\.(command|textconv)|filter\..+|merge\..+\.driver|alias\..+|pager\..+"
    r"|credential\..+|include\.path|includeif\..+|gpg\..*program|sequence\.editor|uploadpack\..+"
    r"|remote\..+\.(uploadpack|receivepack|proxy|vcs)|protocol\..+|submodule\..+\.update)$"
)

# How far the scan goes. Past these, it stops and says the check is incomplete.
MAX_DEPTH = 20
MAX_ENTRIES = 200_000
MAX_SECONDS = 30
# Bigger files are fingerprinted by their size and start only; bigger lock files aren't read
MAX_HASH_BYTES = 50 * 1024 * 1024
MAX_LOCK_BYTES = 50 * 1024 * 1024
MAX_CONFIG_BYTES = 1024 * 1024


def project_root(path):
    """The project folder to check: Claude's copy if the path is in it, otherwise the
    nearest folder above with a .git in it. Worked out from the paths alone."""
    path = os.path.abspath(path)
    if path == WORK or path.startswith(WORK + os.sep):
        return WORK
    probe = path
    while True:
        if os.path.lexists(os.path.join(probe, ".git")):
            return probe
        parent = os.path.dirname(probe)
        if parent == probe:
            return path
        probe = parent


def is_sensitive(rel):
    parts = rel.split("/")
    folders, name = parts[:-1], parts[-1]
    if rel in IGNORED_FILES or SKIP_DIRS.intersection(folders):
        return False
    if SENSITIVE_DIRS.intersection(folders):
        return True
    return any(fnmatch.fnmatch(name, pattern) for pattern in SENSITIVE_NAMES)


def runnable(mode):
    """An ordinary file marked runnable (any execute bit) counts whatever it's called."""
    return stat.S_ISREG(mode) and bool(mode & 0o111)


class Scan:
    """One walk of the project, noting anything that stopped it seeing everything."""

    def __init__(self, root):
        self.root = root
        self.incomplete = []
        self.files = []        # (parts, name, runnable) for every file seen
        self._walk()

    def note(self, problem):
        if problem not in self.incomplete and len(self.incomplete) < 20:
            self.incomplete.append(problem)

    def _walk(self):
        started = time.monotonic()
        entries = 0

        def unreadable(error):
            rel = os.path.relpath(getattr(error, "filename", "") or self.root, self.root)
            self.note(f"couldn't read the folder {rel}")

        for cur, dirs, files in os.walk(self.root, onerror=unreadable):
            rel = os.path.relpath(cur, self.root)
            parts = [] if rel == "." else rel.split(os.sep)
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            if len(parts) >= MAX_DEPTH and dirs:
                self.note(f"folders deeper than {MAX_DEPTH} levels weren't checked ({rel})")
                dirs[:] = []
            entries += len(files) + len(dirs)
            for name in files:
                try:
                    mode = os.lstat(os.path.join(cur, name)).st_mode
                except OSError:
                    mode = 0
                self.files.append((parts, name, runnable(mode)))
            if entries > MAX_ENTRIES:
                self.note(f"stopped after {MAX_ENTRIES} files and folders")
                break
            if time.monotonic() - started > MAX_SECONDS:
                self.note(f"stopped after {MAX_SECONDS} seconds")
                break

    def sensitive_files(self):
        found = []
        for parts, name, can_run in self.files:
            rel = os.path.join(*parts, name) if parts else name
            if is_sensitive(rel) or (can_run and not SKIP_DIRS.intersection(parts)):
                found.append(rel)
        return sorted(found)

    def lock_files(self):
        return sorted(os.path.join(*parts, name) if parts else name
                      for parts, name, _ in self.files if name in LOCK_FILES)


def open_regular(path):
    """Open a file only if it's an ordinary file, not a link, pipe or device: those could
    make the check hang or read something else. Returns None otherwise."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        return None
    return os.fdopen(fd, "rb")


def file_hash(path, with_mode=False):
    """A file's fingerprint: its contents (and, with_mode, whether it can be run). Returns
    (fingerprint, problem): problem says why the check couldn't see the file fully."""
    try:
        info = os.lstat(path)
    except OSError:
        return None, None
    mode = info.st_mode
    if stat.S_ISLNK(mode):
        try:
            target = os.readlink(path)
        except OSError:
            target = "?"
        # The link's target is part of the fingerprint, so pointing it elsewhere shows
        return f"link to {target}", "is a link; check where it leads by hand"
    if not stat.S_ISREG(mode):
        return f"not a plain file ({stat.filemode(mode)})", "isn't a plain file"
    fh = open_regular(path)
    if fh is None:
        return f"can't be read ({info.st_size} bytes, changed {int(info.st_mtime)})", "can't be read"
    digest = hashlib.sha256()
    problem = None
    try:
        with fh:
            left = MAX_HASH_BYTES
            while left > 0:
                chunk = fh.read(min(65536, left))
                if not chunk:
                    break
                digest.update(chunk)
                left -= len(chunk)
    except OSError:
        return f"can't be read ({info.st_size} bytes)", "can't be read"
    fingerprint = digest.hexdigest()
    if info.st_size > MAX_HASH_BYTES:
        # The rest isn't read, so the time the file was last changed stands in for it: the
        # system sets that on every write, and no user can set it back
        fingerprint += f" (first {MAX_HASH_BYTES} of {info.st_size} bytes, changed {info.st_ctime_ns})"
        problem = "is too big to check fully"
    if with_mode:
        fingerprint = f"{stat.filemode(mode)} {fingerprint}"
    return fingerprint, problem


def read_text(path, limit):
    """A file's text, if it's a plain file no bigger than limit. (None, problem) otherwise."""
    fh = open_regular(path)
    if fh is None:
        return None, "isn't a plain file it can read"
    try:
        with fh:
            data = fh.read(limit + 1)
    except OSError:
        return None, "can't be read"
    if len(data) > limit:
        return None, f"is bigger than {limit} bytes, so it wasn't read"
    return data.decode("utf-8", "replace"), None


def packages_from(data, rel):
    """One lock file's packages, from its bytes, as {key: [name to show, version]}. A lock
    file that isn't what it should be gives no packages, rather than stopping the check."""
    try:
        data = json.loads(data)
    except (ValueError, UnicodeDecodeError):
        return {}
    if not isinstance(data, dict):
        return {}
    folder = os.path.dirname(rel)
    prefix = f"{folder}: " if folder else ""
    packages = {}
    if os.path.basename(rel) == "composer.lock":
        for section in ("packages", "packages-dev"):
            entries = data.get(section)
            for meta in entries if isinstance(entries, list) else []:
                if isinstance(meta, dict) and isinstance(meta.get("name"), str) and meta["name"]:
                    packages[f"{rel}|{meta['name']}"] = [prefix + meta["name"], str(meta.get("version", ""))]
    else:
        entries = data.get("packages")
        for key, meta in (entries.items() if isinstance(entries, dict) else []):
            if key and isinstance(key, str):
                version = meta.get("version", "") if isinstance(meta, dict) else ""
                packages[f"{rel}|{key}"] = [prefix + key.split("node_modules/")[-1], str(version)]
    return packages


def lock_packages(root, rel, scan):
    fh = open_regular(os.path.join(root, rel))
    if fh is None:
        return {}
    with fh:
        if os.fstat(fh.fileno()).st_size > MAX_LOCK_BYTES:
            scan.note(f"{rel} is too big to compare its packages")
            return {}
        try:
            data = fh.read(MAX_LOCK_BYTES + 1)
        except OSError:
            return {}
    return packages_from(data, rel)


SECTION = re.compile(r'^\[\s*([A-Za-z0-9.-]+)(?:\s+"((?:[^"\\]|\\.)*)")?\s*\]')
KEY = re.compile(r"^([A-Za-z][A-Za-z0-9-]*)\s*(?:=\s*(.*))?$")


def git_config_entries(text):
    """The settings in a git config file, as (name, value), read as text: section and key
    names lower-case, subsections as written. Lines it can't make sense of are returned too,
    as ("?", line), so nothing unusual goes unseen."""
    entries = []
    section = None
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        line = lines[i]
        # A value can carry on over the next line, after a backslash
        while line.rstrip().endswith("\\") and i + 1 < len(lines):
            i += 1
            line = line.rstrip()[:-1] + lines[i]
        i += 1
        stripped = line.strip()
        if not stripped or stripped[0] in "#;":
            continue
        if stripped.startswith("["):
            match = SECTION.match(stripped)
            if not match:
                entries.append(("?", stripped))
                section = None
                continue
            name, sub = match.group(1), match.group(2)
            if sub is not None:
                section = f"{name.lower()}.{sub.lower()}"
            elif "." in name:  # the old [section.subsection] form
                head, _, rest = name.partition(".")
                section = f"{head.lower()}.{rest.lower()}"
            else:
                section = name.lower()
            stripped = stripped[match.end():].strip()
            if not stripped or stripped[0] in "#;":
                continue
        match = KEY.match(stripped)
        if not match or section is None:
            entries.append(("?", stripped))
            continue
        entries.append((f"{section}.{match.group(1).lower()}", (match.group(2) or "true").strip()))
    return entries


def git_state(root, scan):
    """Hooks (each with its fingerprint), and settings that run commands, read from the files
    in .git without running git."""
    state = {"hooks": {}, "config": [], "extras": {}}
    gitdir = os.path.join(root, ".git")
    try:
        if not stat.S_ISDIR(os.lstat(gitdir).st_mode):
            state["config"].append(".git isn't a folder (a link, or a file pointing elsewhere)")
            return state
    except OSError:
        return state
    hooks = os.path.join(gitdir, "hooks")
    try:
        names = os.listdir(hooks)
    except FileNotFoundError:
        names = []
    except OSError:
        names = []
        scan.note("couldn't read .git/hooks")
    for name in sorted(names):
        if not name.endswith(".sample"):
            fingerprint, problem = file_hash(os.path.join(hooks, name), with_mode=True)
            state["hooks"][name] = fingerprint
            if problem:
                scan.note(f".git/hooks/{name} {problem}")
    for extra in GIT_EXTRAS:
        path = os.path.join(gitdir, extra)
        if os.path.lexists(path):
            fingerprint, problem = file_hash(path)
            state["extras"][extra] = fingerprint
            if problem:
                scan.note(f".git/{extra} {problem}")
    for config in ("config", "config.worktree"):
        path = os.path.join(gitdir, config)
        if not os.path.lexists(path):
            continue
        text, problem = read_text(path, MAX_CONFIG_BYTES)
        if text is None:
            scan.note(f".git/{config} {problem}")
            continue
        for name, value in git_config_entries(text):
            if name == "?" or RISKY_GIT_CONFIG.match(name):
                shown = f"unreadable line: {value}" if name == "?" else f"{name}={value}"
                state["config"].append(f"{config}: {shown[:200]}")
    return state


def take_state(root):
    scan = Scan(root)
    files = {}
    for rel in scan.sensitive_files():
        fingerprint, problem = file_hash(os.path.join(root, rel), with_mode=True)
        files[rel] = fingerprint
        if problem:
            scan.note(f"{rel} {problem}")
    packages = {}
    for rel in scan.lock_files():
        packages.update(lock_packages(root, rel, scan))
    return {
        "files": files,
        "packages": packages,
        "git": git_state(root, scan),
        "incomplete": scan.incomplete,
    }


def printable(text):
    """Names come from the project; nothing in them may act on your terminal."""
    return "".join(c if c.isprintable() else "?" for c in str(text))


def package_changes(old, new):
    lines = []
    for key, (name, version) in sorted(new.items()):
        if key not in old:
            lines.append(f"added    {name}@{version}")
        elif old[key][1] != version:
            lines.append(f"changed  {name} {old[key][1]} -> {version}")
    for key, (name, version) in sorted(old.items()):
        if key not in new:
            lines.append(f"removed  {name}@{version}")
    return lines


def package_lines(packages):
    if not packages:
        return []
    lines = ["Packages changed (check the names for typos or look-alikes):"]
    lines += [f"  {p}" for p in packages[:30]]
    if len(packages) > 30:
        lines.append(f"  ...and {len(packages) - 30} more")
    return lines


def changes(old, new):
    """(kind, name) for each added, changed and removed entry of two {name: fingerprint}"""
    return sorted([("added   ", f) for f in new if f not in old]
                  + [("changed ", f) for f in new if f in old and old[f] != new[f]]
                  + [("removed ", f) for f in old if f not in new], key=lambda item: item[1])


def diff_states(old, new, all_incomplete=True):
    """What changed, as lines to show. all_incomplete: say everything the check couldn't
    see, not just what's new since the last check (which is all the hooks after each turn say)."""
    lines = []
    changed = changes(old.get("files", {}), new["files"])
    if changed:
        lines.append("Watched files were changed (package, config and deploy files, scripts, runnable files):")
        lines += [f"  {kind}{path}" for kind, path in changed]

    lines += package_lines(package_changes(old.get("packages", {}), new["packages"]))

    old_git, new_git = old.get("git", {}), new["git"]
    old_hooks = old_git.get("hooks", {})
    if isinstance(old_hooks, list):  # a baseline from an earlier version: names only
        old_hooks = {name: new_git["hooks"].get(name) for name in old_hooks}
    hooks = changes(old_hooks, new_git["hooks"])
    extras = changes(old_git.get("extras", {}), new_git.get("extras", {}))
    new_config = sorted(set(new_git["config"]) - set(old_git.get("config", [])))
    if hooks or extras or new_config:
        lines.append("Git hooks or settings that run commands were changed:")
        lines += [f"  {kind}.git/hooks/{name}" for kind, name in hooks]
        lines += [f"  {kind}.git/{name}" for kind, name in extras]
        lines += [f"  added   .git/{c}" for c in new_config]

    incomplete = new.get("incomplete", [])
    if not all_incomplete:
        incomplete = [p for p in incomplete if p not in old.get("incomplete", [])]
    if incomplete:
        lines.append("The check couldn't see everything, so review by hand too:")
        lines += [f"  {problem}" for problem in incomplete]
    return [printable(line) for line in lines]


# --- The branch itself, in your own copy ---------------------------------------------------

def git(repo, *args, data=False):
    """git in your own copy of the project (never Claude's), without hooks or fsmonitor."""
    out = subprocess.run(["git", "-C", repo, "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null",
                          *args], capture_output=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError(f"git {args[0]} failed: {out.stderr.decode('utf-8', 'replace').strip()[:200]}")
    return out.stdout if data else out.stdout.decode("utf-8", "surrogateescape")


def blob(repo, commit, path, problems):
    """A file's contents at a commit, or b"" if it isn't there or is too big."""
    if commit is None:
        return b""
    spec = f"{commit}:{path}"
    try:
        size = int(git(repo, "cat-file", "-s", spec).strip())
    except (RuntimeError, ValueError):
        return b""
    if size > MAX_LOCK_BYTES:
        problems.append(f"{path} is too big to compare its packages")
        return b""
    return git(repo, "cat-file", "blob", spec, data=True)


def review_lines(repo, base, branch):
    """What the branch changes since it left base: what merging it would bring in."""
    problems = []
    start = None
    if base:
        try:
            start = git(repo, "merge-base", base, branch).strip() or None
        except RuntimeError:
            start = None
    changed = []   # (status, path, runnable now)
    if start:
        # --raw gives the modes too: a file marked runnable counts whatever it's called
        listing = git(repo, "diff", "--no-renames", "--raw", "-z", start, branch)
        fields = listing.split("\0")
        for meta, path in zip(fields[0::2], fields[1::2]):
            if path and meta.startswith(":"):
                bits = meta[1:].split()
                if len(bits) >= 5:
                    changed.append((bits[4][:1], path, bits[1].endswith("755")))
    else:  # nothing in common: everything on the branch is new
        listing = git(repo, "ls-tree", "-r", "-z", branch)
        for entry in listing.split("\0"):
            if "\t" in entry:
                meta, path = entry.split("\t", 1)
                bits = meta.split()
                changed.append(("A", path, bits[0].endswith("755") if bits else False))
    kinds = {"A": "added   ", "M": "changed ", "D": "removed ", "T": "changed "}
    lines = []
    sensitive = [(kinds.get(status, "changed "), path) for status, path, can_run in changed
                 if is_sensitive(path) or (can_run and not SKIP_DIRS.intersection(path.split("/")[:-1]))]
    if sensitive:
        lines.append("Watched files were changed (package, config and deploy files, scripts, runnable files):")
        lines += [f"  {kind}{path}" for kind, path in sensitive]
    old_packages, new_packages = {}, {}
    for status, path, _ in changed:
        if os.path.basename(path) in LOCK_FILES:
            old_packages.update(packages_from(blob(repo, start, path, problems), path))
            new_packages.update(packages_from(blob(repo, branch, path, problems), path))
    lines += package_lines(package_changes(old_packages, new_packages))
    if problems:
        lines.append("The check couldn't see everything, so review by hand too:")
        lines += [f"  {p}" for p in problems]
    return [printable(line) for line in lines]


def run_review(repo, base, branch):
    name = branch[len("refs/heads/"):] if branch.startswith("refs/heads/") else branch
    try:
        lines = review_lines(repo, base, branch)
    except Exception as exc:  # report the failure rather than skip the check quietly
        lines = [f"the check failed ({printable(exc)}); review the branch's changes by hand"]
    if lines:
        print("=" * 72)
        print(f"Heimdall: on {printable(name)}, review these before merging it.")
        for line in lines:
            print(line)
        print("=" * 72)
    else:
        print(f"Heimdall: nothing on {printable(name)} changes the files it watches (package, config and deploy "
              "files, scripts, runnable files, git settings). The rest of the diff is yours to read.")


# --- Saving and loading checks ---------------------------------------------------------------

def save(path, state):
    with open(path, "w") as fh:
        json.dump(state, fh)


def load(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def hook_state_path(session_id):
    safe = re.sub(r"[^A-Za-z0-9_-]", "", session_id or "")[:80] or "default"
    folder = os.path.join(os.path.expanduser("~"), ".cache", "heimdall")
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, safe + ".json")


def run_hook(start):
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    root = project_root(os.environ.get("CLAUDE_PROJECT_DIR") or data.get("cwd") or os.getcwd())
    path = hook_state_path(data.get("session_id"))
    new = take_state(root)
    if not start:
        old = load(path)
        if old:
            lines = diff_states(old, new, all_incomplete=False)
            if lines:
                print(json.dumps({"systemMessage": "\n".join([HEADER] + lines)}))
    save(path, new)


def run_summary(snapshot, directory):
    root = project_root(directory)
    old = load(snapshot)
    try:
        lines = diff_states(old, take_state(root)) if old else ["(no snapshot was taken at the start of the session)"]
    except Exception as exc:  # report the failure rather than skip the summary quietly
        lines = [f"Heimdall: the check failed ({printable(exc)}); review the session's changes by hand"]
    print()
    if lines:
        print("=" * 72)
        print("Heimdall: what changed in Claude's copy this session, committed or not.")
        for line in lines:
            print(line)
        print("=" * 72)
    else:
        print("Heimdall: nothing changed this session among the files it watches (package, config and deploy "
              "files, scripts, runnable files, git settings). Ordinary source may have.")


def main(argv):
    mode = argv[1] if len(argv) > 1 else ""
    if mode in ("--hook-start", "--hook"):
        try:
            run_hook(start=(mode == "--hook-start"))
        except Exception as exc:  # a failed check must never break Claude Code
            print(json.dumps({"systemMessage": f"Heimdall: check failed: {printable(exc)}"}))
        return 0
    if mode == "--snapshot" and len(argv) >= 3:
        save(argv[2], take_state(project_root(argv[3] if len(argv) > 3 else os.getcwd())))
        return 0
    if mode == "--summary" and len(argv) >= 3:
        run_summary(argv[2], argv[3] if len(argv) > 3 else os.getcwd())
        return 0
    if mode == "--review" and len(argv) == 5:
        run_review(argv[2], argv[3], argv[4])
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))