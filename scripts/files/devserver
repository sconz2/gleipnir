#!/usr/bin/env bash
# Gleipnir: control the project's dev servers, one per app.
#   devserver [status|start|stop|restart|log [-f]|list] [app]
set -euo pipefail

LIST=/etc/gleipnir/devservers
LOG_DIR=/var/log/gleipnir

usage() {
  cat <<'EOF'
Usage: devserver [command] [app]

  status       Are they running? (the default)
  start        Start them
  stop         Stop them, until the next start or reboot
  restart      Restart them, e.g. after changing .env or installing packages
  log          Show the end of their output
  log -f       Follow their output as it happens (Ctrl+C to stop)
  list         Each app's folder, port and command

Each command works on every app unless you name one, e.g. devserver restart backend.
EOF
}

# The apps with a dev server: name, folder, port, command
names() { cut -f1 "$LIST" 2>/dev/null; }

# The dev servers are system services, run as runner. Anyone can see how they are; dev (the
# editor's terminal, allowed by a polkit rule) and the admin user (with sudo) can control them.
control() {
  if [ "$(id -u)" -eq 0 ] || [ "$(id -un)" = dev ]; then
    systemctl --no-ask-password "$@"
  elif sudo -n true 2>/dev/null; then
    sudo -n systemctl --no-ask-password "$@"
  else
    echo "devserver: only dev (the editor's terminal) or the admin user can start and stop the dev servers." >&2
    exit 1
  fi
}

command="${1:-status}"
[ $# -gt 0 ] && shift
follow=no
if [ "$command" = log ] || [ "$command" = logs ]; then
  if [ "${1:-}" = "-f" ]; then follow=yes; shift; fi
fi
app="${1:-}"

case "$command" in
  -h|--help|help) usage; exit 0 ;;
esac

if [ ! -s "$LIST" ]; then
  echo "devserver: no dev servers are set up on this machine (see devserver in its config, and its apps)." >&2
  exit 1
fi

# The apps to act on
if [ -n "$app" ]; then
  if ! names | grep -qxF "$app"; then
    echo "devserver: no dev server called \"$app\". These are set up: $(names | paste -sd ' ')" >&2
    exit 1
  fi
  targets=("$app")
else
  mapfile -t targets < <(names)
fi
units=()
logs=()
for name in "${targets[@]}"; do
  units+=("gleipnir-dev@$name.service")
  logs+=("$LOG_DIR/devserver-$name.log")
done

case "$command" in
  status)
    systemctl status --no-pager --lines=0 "${units[@]}" || true
    ;;
  start|restart)
    control reset-failed "${units[@]}" >/dev/null 2>&1 || true
    control "$command" "${units[@]}"
    echo "${command^}ed: ${targets[*]}. Output: devserver log -f${app:+ $app}"
    ;;
  stop)
    control stop "${units[@]}"
    echo "Stopped: ${targets[*]}"
    ;;
  try-restart)
    # Restart only those that are running. Used after the .env files are updated.
    for unit in "${units[@]}"; do
      if systemctl is-active --quiet "$unit"; then
        control restart "$unit"
        echo "Dev server restarted: ${unit#gleipnir-dev@}" | sed 's/\.service$//'
      fi
    done
    ;;
  log|logs)
    # Readable by dev and Claude; the admin user reads them with sudo
    reader=()
    if [ ! -r "$LOG_DIR" ] && sudo -n true 2>/dev/null; then reader=(sudo -n); fi
    if [ "$follow" = yes ]; then
      exec "${reader[@]}" tail -n 50 -F "${logs[@]}"
    else
      exec "${reader[@]}" tail -n 50 "${logs[@]}"
    fi
    ;;
  list)
    printf '%-14s %-16s %-6s %s\n' APP FOLDER PORT COMMAND
    while IFS=$'\t' read -r name folder port cmd; do
      printf '%-14s %-16s %-6s %s\n' "$name" "$folder" "$port" "$cmd"
    done < "$LIST"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac