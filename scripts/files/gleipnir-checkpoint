#!/usr/bin/env bash
# Gleipnir: a Claude Code Stop hook. Commits anything Claude left uncommitted,
# on its own wip/ branch only. Never fails the turn.

dir="${CLAUDE_PROJECT_DIR:-/srv/project}"
cat >/dev/null   # the hook's input, which isn't needed

branch="$(git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null)" || exit 0
case "$branch" in
  wip/*) ;;
  *) exit 0 ;;
esac

[ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ] || exit 0

if git -C "$dir" add -A >/dev/null 2>&1 && git -C "$dir" commit -q -m "Checkpoint" >/dev/null 2>&1; then
  printf '{"systemMessage": "Gleipnir: saved leftover changes as a checkpoint commit on %s."}\n' "$branch"
fi
exit 0