#!/usr/bin/env bash
# Gleipnir: copy the project's context folder from your computer to /srv/context, where
# Claude can read it but not change, rename or replace it: it's owned by root and sits
# outside both copies of the project. Your computer's copy wins: the folder is replaced each
# time, so files removed there are removed here too.
#
#   gleipnir-context <folder>     (run as root, by provisioning)
set -euo pipefail

SRC_DIR="${1:?usage: gleipnir-context <folder>}"
DEST=/srv/context

[ -d "$SRC_DIR" ] || { echo "Gleipnir: $SRC_DIR isn't a folder" >&2; exit 1; }

# Built beside it, then swapped in. Links are dropped: context is plain files.
rm -rf "$DEST.new" "$DEST.old"
cp -R "$SRC_DIR" "$DEST.new"
find "$DEST.new" -type l -delete
chown -R root:project "$DEST.new"
find "$DEST.new" -type d -exec chmod 0750 {} +
find "$DEST.new" -type f -exec chmod 0640 {} +
if [ -e "$DEST" ]; then mv "$DEST" "$DEST.old"; fi
mv "$DEST.new" "$DEST"
rm -rf "$DEST.old"

count="$(find "$DEST" -type f | wc -l)"
if [ "$count" -eq 1 ]; then files="1 file"; else files="$count files"; fi
echo "Gleipnir: project context copied to $DEST ($files)"