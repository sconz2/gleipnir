#!/usr/bin/env bash
# Gleipnir: Gjöll, the firewall for the users that run code you didn't write.
# Everything else in the machine (provisioning, dev, the editor) is unaffected.
#
#   claude    In allowlist mode: localhost only, and its way out is its port on
#             the proxy (Squid), which checks every site by name. No DNS, so it
#             can't look names up or smuggle data out in lookups. In open mode:
#             anything, logged.
#   proxy     Squid itself: HTTPS (port 443) out, and localhost, which includes
#             the machine's DNS resolver. Nothing else.
#   postgres  The database server: localhost (but not the proxy), and replies to
#             connections made to it. It never needs to connect out.
#
# In every mode, claude can't connect to the editor (port 8080), which has no
# password and would otherwise give it a terminal as dev.
#
#   gjoll-firewall             apply the rules if missing
#   gjoll-firewall --rebuild   remove and re-create the rules
#   gjoll-firewall --remove    remove the rules
#   gjoll-firewall --check     exit 0 only if the rules are in place
#   gjoll-firewall --verify    apply if missing, then test that blocking works
set -uo pipefail

MODE="$(cat /etc/gleipnir/claude-network 2>/dev/null || echo allowlist)"
EDITOR_PORT=8080
CLAUDE_PROXY_PORT=3128
# Not claude's: the dev servers' proxy port, and Squid's inner ports
OTHER_PROXY_PORTS=3129,3138,3139
# Blocked attempts are logged, but no faster than this, so a retry loop can't flood the log
LOG_LIMIT=(-m limit --limit 10/min --limit-burst 20)

# Each user Gjöll covers, and its chain
declare -A CHAINS=([claude]=GJOLL [proxy]=GJOLL_PROXY [postgres]=GJOLL_PG)

user_exists() { id -u "$1" >/dev/null 2>&1; }

jump_present() { # ipt user chain
  "$1" -C OUTPUT -m owner --uid-owner "$2" -j "$3" >/dev/null 2>&1
}

rules_present() {
  local ipt user
  for ipt in iptables ip6tables; do
    for user in "${!CHAINS[@]}"; do
      user_exists "$user" || continue
      jump_present "$ipt" "$user" "${CHAINS[$user]}" || return 1
    done
    # The rules that matter most: claude kept out of the editor, and the final verdict
    "$ipt" -C GJOLL -p tcp --dport "$EDITOR_PORT" -j REJECT --reject-with tcp-reset >/dev/null 2>&1 || return 1
    if [ "$MODE" = "open" ]; then
      "$ipt" -C GJOLL -j ACCEPT >/dev/null 2>&1 || return 1
    else
      "$ipt" -C GJOLL -o lo -p tcp --dport "$CLAUDE_PROXY_PORT" -j ACCEPT >/dev/null 2>&1 || return 1
      "$ipt" -C GJOLL -j REJECT >/dev/null 2>&1 || return 1
    fi
  done
}

remove_rules() {
  local ipt user chain
  for ipt in iptables ip6tables; do
    for user in "${!CHAINS[@]}"; do
      chain="${CHAINS[$user]}"
      if user_exists "$user"; then
        while "$ipt" -D OUTPUT -m owner --uid-owner "$user" -j "$chain" 2>/dev/null; do :; done
      fi
      "$ipt" -F "$chain" 2>/dev/null || true
      "$ipt" -X "$chain" 2>/dev/null || true
    done
  done
}

# A fresh, empty chain
new_chain() { # ipt chain
  "$1" -F "$2" 2>/dev/null && "$1" -X "$2" 2>/dev/null
  "$1" -N "$2"
}

# Log (rate-limited), then refuse
log_and_reject() { # ipt chain label
  "$1" -A "$2" "${LOG_LIMIT[@]}" -j LOG --log-prefix "gjoll $3 blocked: " --log-uid
  "$1" -A "$2" -j REJECT
}

# Swap a finished chain in for a user, with no moment where the user is unrestricted:
# the new chain's jump goes in first, then the old chain is removed and the new one renamed.
swap_in() { # ipt user chain
  local ipt="$1" user="$2" chain="$3"
  "$ipt" -I OUTPUT 1 -m owner --uid-owner "$user" -j "$chain.new"
  while "$ipt" -D OUTPUT -m owner --uid-owner "$user" -j "$chain" 2>/dev/null; do :; done
  "$ipt" -F "$chain" 2>/dev/null && "$ipt" -X "$chain" 2>/dev/null
  "$ipt" -E "$chain.new" "$chain"
}

build_claude() { # ipt chain
  local ipt="$1" c="$2"
  "$ipt" -A "$c" -p tcp --dport "$EDITOR_PORT" -j REJECT --reject-with tcp-reset
  if [ "$MODE" = "open" ]; then
    "$ipt" -A "$c" -o lo -j ACCEPT
    "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    "$ipt" -A "$c" -m conntrack --ctstate NEW -j LOG --log-prefix "gjoll claude: " --log-uid
    "$ipt" -A "$c" -j ACCEPT
  else
    # No DNS, including the machine's own resolver on 127.0.0.53. Logged: it usually
    # means a tool that isn't using the proxy.
    local proto
    for proto in udp tcp; do
      "$ipt" -A "$c" -p "$proto" --dport 53 "${LOG_LIMIT[@]}" -j LOG --log-prefix "gjoll claude blocked: " --log-uid
      "$ipt" -A "$c" -p "$proto" --dport 53 -j REJECT
    done
    "$ipt" -A "$c" -o lo -p tcp --dport "$CLAUDE_PROXY_PORT" -j ACCEPT
    "$ipt" -A "$c" -o lo -p tcp -m multiport --dports "$OTHER_PROXY_PORTS" -j REJECT --reject-with tcp-reset
    # The rest of localhost: the dev server, the database
    "$ipt" -A "$c" -o lo -j ACCEPT
    "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    log_and_reject "$ipt" "$c" claude
  fi
}

build_proxy() { # ipt chain
  local ipt="$1" c="$2"
  "$ipt" -A "$c" -p tcp --dport "$EDITOR_PORT" -j REJECT --reject-with tcp-reset
  "$ipt" -A "$c" -o lo -j ACCEPT
  "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  "$ipt" -A "$c" -p tcp --dport 443 -j ACCEPT
  log_and_reject "$ipt" "$c" proxy
}

build_postgres() { # ipt chain
  local ipt="$1" c="$2"
  # Not the proxy either: the database never needs to reach a website
  "$ipt" -A "$c" -o lo -p tcp -m multiport --dports "$CLAUDE_PROXY_PORT,$OTHER_PROXY_PORTS" -j REJECT --reject-with tcp-reset
  "$ipt" -A "$c" -o lo -j ACCEPT
  # Replies to connections made to it, including your computer's through the forwarded port
  "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  log_and_reject "$ipt" "$c" postgres
}

# Each chain is built complete, ending in a verdict, before it's swapped in
build_rules() {
  local ipt user chain
  for ipt in iptables ip6tables; do
    for user in claude proxy postgres; do
      user_exists "$user" || continue
      chain="${CHAINS[$user]}"
      new_chain "$ipt" "$chain.new"
      "build_$user" "$ipt" "$chain.new"
      swap_in "$ipt" "$user" "$chain"
    done
  done
  # Left over from the version that allowed sites by address
  if command -v ipset >/dev/null 2>&1; then
    ipset destroy gjoll-allowed 2>/dev/null || true
    ipset destroy gjoll-allowed-new 2>/dev/null || true
  fi
}

# Does the claude user get through? (0 = it connected)
as_claude_curl() {
  sudo -u claude curl -s --max-time 8 -o /dev/null "$@"
}

verify() {
  local failed=0 code address

  if as_claude_curl "http://127.0.0.1:$EDITOR_PORT/healthz"; then
    echo "Gjöll: ERROR: the claude user can reach the editor" >&2
    failed=1
  fi

  if [ "$MODE" = "open" ]; then
    [ "$failed" -eq 0 ] && echo "Gjöll: verified (editor blocked; open network)"
    return "$failed"
  fi

  # No DNS for claude
  if sudo -u claude getent ahosts example.com >/dev/null 2>&1; then
    echo "Gjöll: ERROR: the claude user can look up names (DNS isn't blocked)" >&2
    failed=1
  fi

  # No direct connections, even to an address that works for everyone else
  address="$(getent ahostsv4 example.com 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [ -z "$address" ]; then
    echo "Gjöll: WARNING: couldn't look up example.com to test direct connections" >&2
  elif as_claude_curl --noproxy '*' -k "https://$address/"; then
    echo "Gjöll: ERROR: the claude user can connect directly to $address, bypassing the proxy" >&2
    failed=1
  fi

  # Not the dev servers' proxy port, nor Squid's inner ports
  if as_claude_curl --noproxy '*' "http://127.0.0.1:3139/" || as_claude_curl --noproxy '*' "http://127.0.0.1:3138/"; then
    echo "Gjöll: ERROR: the claude user can reach a proxy port that isn't its own" >&2
    failed=1
  fi

  # The proxy refuses sites that aren't listed. This name doesn't exist and is never looked up.
  code="$(sudo -u claude curl -s --max-time 8 -o /dev/null -w '%{http_connect}' \
    -x "http://127.0.0.1:$CLAUDE_PROXY_PORT" https://gleipnir-check.invalid/ 2>/dev/null)"
  case "$code" in
    403) ;;
    000) echo "Gjöll: WARNING: the proxy isn't answering; Claude has no network until it does (sudo systemctl restart squid)" >&2 ;;
    *)   echo "Gjöll: ERROR: the proxy didn't refuse a site that isn't on the list (answered $code)" >&2; failed=1 ;;
  esac

  # And lets Anthropic through
  if [ "$code" = "403" ] && ! as_claude_curl -x "http://127.0.0.1:$CLAUDE_PROXY_PORT" https://api.anthropic.com; then
    echo "Gjöll: WARNING: the claude user can't reach api.anthropic.com through the proxy; Claude Code may not work" >&2
  fi

  [ "$failed" -eq 0 ] && echo "Gjöll: verified"
  return "$failed"
}

case "${1:-}" in
  "")        rules_present || build_rules ;;
  --rebuild) build_rules ;;
  --remove)  remove_rules; echo "Gjöll: removed" ;;
  --check)   rules_present ;;
  --verify)  rules_present || build_rules; verify ;;
  *)         echo "usage: $0 [--rebuild|--remove|--check|--verify]" >&2; exit 2 ;;
esac