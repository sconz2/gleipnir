#!/usr/bin/env bash
# Gleipnir: Gjöll, the firewall for the users that run code you didn't write.
# Everything else in the machine (provisioning, dev, the editor) is unaffected.
#
#   claude    In allowlist mode: localhost only, and its way out is its port on
#             the proxy (Squid), which checks every site by name. No DNS, so it
#             can't look names up or smuggle data out in lookups. In open mode:
#             anything, logged.
#   runner    The dev servers: the same, with a port of its own on the proxy and its
#             own list of sites (runner.allowed_domains, empty unless you add some).
#   proxy     Squid itself: HTTPS (port 443) out, and localhost, which includes
#             the machine's DNS resolver. Nothing else. (Squid decrypts the package
#             sites to check each request, so it makes those connections itself.)
#   postgres  The database server: localhost (but not the proxy or the editor), and
#             replies to connections made to it. It never needs to connect out.
#
# In every mode, none of them can connect to the editor (port 8080), which would give
# them a terminal as dev, and claude and runner can't reach the machine's own services on
# the low ports (1-1023: sshd and the like, which only root can run), so a local login as
# another user is out of reach. Everything else on localhost (the dev servers, the
# database, servers of their own) is open to them.
#
# The rules for IPv4 and IPv6 are each put in place in one step (iptables-restore): all of
# them or none, so a failure leaves the previous rules as they were, never a gap. --check
# makes sure each chain has the rules it should, first in OUTPUT and in order, and compares
# every live rule with what was put in place. Replies are let through only as replies: a
# connection claude or runner opened before the rules went on can't carry on afterwards.
#
#   gjoll-firewall             check the rules, and put them in place if they're not right
#   gjoll-firewall --rebuild   put them in place again
#   gjoll-firewall --remove    remove them
#   gjoll-firewall --check     exit 0 only if every rule is in place, as it should be
#   gjoll-firewall --verify    put them in place if they're not right, then test that blocking works
set -uo pipefail

MODE="$(cat /etc/gleipnir/claude-network 2>/dev/null || echo allowlist)"
EDITOR_PORT=8080
CLAUDE_PROXY_PORT=3128
RUNNER_PROXY_PORT=3129
# Squid's inner ports, which only Squid itself may use
INNER_PROXY_PORTS=3138,3139
# The ports only root can listen on, bar DNS (53)
LOW_PORTS=1:52,54:1023
# What was put in place, for --check (root only)
STATE=/var/lib/gleipnir/gjoll-state
# Read by gjoll-log, so this script's own DNS test isn't reported as a blocked lookup
CHECK_TIMES=/var/lib/gleipnir/dns-check-times
# The certificates claude's tools trust: the system's, plus the proxy's own for the package sites
CA_BUNDLE=/etc/gleipnir/ca-bundle.pem
# Blocked attempts are logged, but no faster than this, so a retry loop can't flood the log
LOG_LIMIT="-m limit --limit 10/min --limit-burst 20"

# Each user Gjöll covers, in the order their rules come first in OUTPUT, and its chain
USERS=(claude runner proxy postgres)
declare -A CHAINS=([claude]=GJOLL [runner]=GJOLL_RUN [proxy]=GJOLL_PROXY [postgres]=GJOLL_PG)
OUR_CHAINS="GJOLL|GJOLL_RUN|GJOLL_PROXY|GJOLL_PG"

uid_of() { id -u "$1" 2>/dev/null; }

say() { echo "Gjöll: $*" >&2; }

# claude and runner must exist: rules for them can't be skipped
required_users() {
  local user
  for user in claude runner; do
    uid_of "$user" >/dev/null || { say "ERROR: the $user user doesn't exist, so its rules can't be put in place"; return 1; }
  done
}

# --- The rules ---------------------------------------------------------------------------------
# Printed in iptables-restore's form, the same for IPv4 and IPv6.

# claude and runner: the same rules, each with its own port on the proxy
contained_rules() { # chain user own-port other-port
  local c="$1" user="$2" own="$3" other="$4" proto
  echo "-A $c -p tcp --dport $EDITOR_PORT -j REJECT --reject-with tcp-reset"
  # Root's services on localhost (sshd, and anything else on a port below 1024, which only
  # root can take), bar DNS, which has rules of its own in each mode
  echo "-A $c -o lo -p tcp -m multiport --dports $LOW_PORTS -j REJECT --reject-with tcp-reset"
  echo "-A $c -o lo -p udp -m multiport --dports $LOW_PORTS -j REJECT"
  if [ "$MODE" = "open" ]; then
    echo "-A $c -o lo -j ACCEPT"
    echo "-A $c -m conntrack --ctstate ESTABLISHED,RELATED --ctdir REPLY -j ACCEPT"
    echo "-A $c -m conntrack --ctstate NEW -j LOG --log-prefix \"gjoll $user: \" --log-uid"
    echo "-A $c -j ACCEPT"
    return
  fi
  # No DNS, including the machine's own resolver on 127.0.0.53. Logged: it usually means
  # a tool that isn't using the proxy.
  for proto in udp tcp; do
    echo "-A $c -p $proto --dport 53 $LOG_LIMIT -j LOG --log-prefix \"gjoll $user blocked: \" --log-uid"
    echo "-A $c -p $proto --dport 53 -j REJECT"
  done
  echo "-A $c -o lo -p tcp --dport $own -j ACCEPT"
  echo "-A $c -o lo -p tcp -m multiport --dports $other,$INNER_PROXY_PORTS -j REJECT --reject-with tcp-reset"
  # The rest of localhost: the dev servers, the database
  echo "-A $c -o lo -j ACCEPT"
  # Replies to connections made to it (the dev servers, from your computer's forwarded ports)
  echo "-A $c -m conntrack --ctstate ESTABLISHED,RELATED --ctdir REPLY -j ACCEPT"
  echo "-A $c $LOG_LIMIT -j LOG --log-prefix \"gjoll $user blocked: \" --log-uid"
  echo "-A $c -j REJECT"
}

proxy_rules() { # chain
  local c="$1"
  echo "-A $c -p tcp --dport $EDITOR_PORT -j REJECT --reject-with tcp-reset"
  echo "-A $c -o lo -j ACCEPT"
  echo "-A $c -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
  echo "-A $c -p tcp --dport 443 -j ACCEPT"
  echo "-A $c $LOG_LIMIT -j LOG --log-prefix \"gjoll proxy blocked: \" --log-uid"
  echo "-A $c -j REJECT"
}

postgres_rules() { # chain
  local c="$1"
  # Not the editor, nor the proxy: the database never needs to reach a website
  echo "-A $c -p tcp --dport $EDITOR_PORT -j REJECT --reject-with tcp-reset"
  echo "-A $c -o lo -p tcp -m multiport --dports $CLAUDE_PROXY_PORT,$RUNNER_PROXY_PORT,$INNER_PROXY_PORTS -j REJECT --reject-with tcp-reset"
  echo "-A $c -o lo -j ACCEPT"
  # Replies to connections made to it, including your computer's through the forwarded port
  echo "-A $c -m conntrack --ctstate ESTABLISHED,RELATED --ctdir REPLY -j ACCEPT"
  echo "-A $c $LOG_LIMIT -j LOG --log-prefix \"gjoll postgres blocked: \" --log-uid"
  echo "-A $c -j REJECT"
}

user_rules() { # user
  local c="${CHAINS[$1]}"
  case "$1" in
    claude)   contained_rules "$c" claude "$CLAUDE_PROXY_PORT" "$RUNNER_PROXY_PORT" ;;
    runner)   contained_rules "$c" runner "$RUNNER_PROXY_PORT" "$CLAUDE_PROXY_PORT" ;;
    proxy)    proxy_rules "$c" ;;
    postgres) postgres_rules "$c" ;;
  esac
}

# The intended rules, for every user that exists. Their fingerprint tells --check whether
# the rules in place were made from the current settings.
intended() {
  local user uid
  echo "mode $MODE"
  for user in "${USERS[@]}"; do
    uid="$(uid_of "$user")" || continue
    echo "user $user $uid"
    user_rules "$user"
  done
}

# One family's whole change, as iptables-restore input: our chains emptied and refilled,
# the old jumps to them removed, and fresh ones put first in OUTPUT, all in one step
restore_input() { # ipt
  local ipt="$1" user uid chain i leftovers
  echo "*filter"
  for user in "${USERS[@]}"; do
    uid_of "$user" >/dev/null || continue
    echo ":${CHAINS[$user]} - [0:0]"
  done
  # Chains left by the earlier, step-by-step way of making them
  leftovers="$("$ipt" -S 2>/dev/null | awk '$1 == "-N" && $2 ~ /^GJOLL[A-Z_]*\.new$/ { print $2 }')"
  for chain in $leftovers; do echo ":$chain - [0:0]"; done
  for user in "${USERS[@]}"; do
    uid_of "$user" >/dev/null || continue
    user_rules "$user"
  done
  "$ipt" -S OUTPUT 2>/dev/null | grep -E -- "-j ($OUR_CHAINS)(\.new)?\$" | sed 's/^-A /-D /'
  for chain in $leftovers; do echo "-X $chain"; done
  for (( i=${#USERS[@]}-1; i>=0; i-- )); do
    user="${USERS[$i]}"
    uid="$(uid_of "$user")" || continue
    echo "-I OUTPUT 1 -m owner --uid-owner $uid -j ${CHAINS[$user]}"
  done
  echo "COMMIT"
}

# One chain as iptables prints it, without its warnings (such as one about tables made by
# iptables-legacy), or a line saying it couldn't be read
listing() { # ipt chain
  local out
  if out="$("$1" -S "$2" 2>/dev/null)"; then
    printf '%s\n' "$out" | grep -v '^#'
  else
    echo "(couldn't read $2)"
  fi
}

# What's live: OUTPUT, and each of our chains
live() { # ipt
  local ipt="$1" user
  listing "$ipt" OUTPUT
  for user in "${USERS[@]}"; do
    uid_of "$user" >/dev/null || continue
    listing "$ipt" "${CHAINS[$user]}"
  done
}

# The shape every family must have, whatever was recorded: our jumps first in OUTPUT, in
# order; each chain with exactly as many rules as it should have, starting with the editor's
# refusal and ending in a refusal (or, in open mode, the logged accept)
structure() { # ipt
  local ipt="$1" user uid chain i=0 rules expected first last problems=0 want_last
  local -a output
  mapfile -t output < <(listing "$ipt" OUTPUT | grep '^-A ')
  for user in "${USERS[@]}"; do
    uid="$(uid_of "$user")" || continue
    chain="${CHAINS[$user]}"
    if [ "${output[$i]:-}" != "-A OUTPUT -m owner --uid-owner $uid -j $chain" ]; then
      say "$ipt: OUTPUT doesn't start with the jump for $user (rule $((i + 1)) is: ${output[$i]:-nothing})"
      problems=1
    fi
    i=$((i + 1))
    rules="$(listing "$ipt" "$chain" | grep '^-A ')"
    expected="$(user_rules "$user" | wc -l)"
    if [ "$(printf '%s\n' "$rules" | grep -c '^-A ')" -ne "$expected" ]; then
      say "$ipt: $chain should have $expected rules"
      problems=1
      continue
    fi
    first="$(printf '%s\n' "$rules" | head -n 1)"
    last="$(printf '%s\n' "$rules" | tail -n 1)"
    if [ "$first" != "-A $chain -p tcp -m tcp --dport $EDITOR_PORT -j REJECT --reject-with tcp-reset" ]; then
      say "$ipt: $chain doesn't start by refusing the editor"
      problems=1
    fi
    want_last="-A $chain -j REJECT --reject-with icmp-port-unreachable"
    [ "$ipt" = ip6tables ] && want_last="-A $chain -j REJECT --reject-with icmp6-port-unreachable"
    if [ "$MODE" = open ] && { [ "$user" = claude ] || [ "$user" = runner ]; }; then
      want_last="-A $chain -j ACCEPT"
    fi
    if [ "$last" != "$want_last" ]; then
      say "$ipt: $chain doesn't end as it should (it ends: $last)"
      problems=1
    fi
  done
  return "$problems"
}

snapshot() {
  local ipt
  echo "intended $(intended | sha256sum | cut -d' ' -f1)"
  for ipt in iptables ip6tables; do
    echo "== $ipt"
    live "$ipt"
  done
}

# --- Putting them in place, checking and removing ----------------------------------------

apply() {
  local ipt input failed=0
  required_users || return 1
  for ipt in iptables ip6tables; do
    input="$(restore_input "$ipt")"
    if ! printf '%s\n' "$input" | "$ipt-restore" -w 10 --noflush; then
      say "ERROR: couldn't put the $ipt rules in place; the previous ones are unchanged"
      failed=1
    fi
  done
  # Left over from the version that allowed sites by address
  if command -v ipset >/dev/null 2>&1; then
    ipset destroy gjoll-allowed 2>/dev/null || true
    ipset destroy gjoll-allowed-new 2>/dev/null || true
  fi
  [ "$failed" -eq 0 ] || return 1
  # Recorded only once each family has the shape it must have
  structure iptables && structure ip6tables || return 1
  install -d -m 0755 "$(dirname "$STATE")"
  ( umask 077; snapshot > "$STATE.new" ) && mv "$STATE.new" "$STATE"
  check
}

check() {
  local expected live_now
  required_users || return 1
  structure iptables && structure ip6tables || return 1
  if [ ! -s "$STATE" ]; then
    say "the rules have never been put in place on this machine"
    return 1
  fi
  if [ "$(head -n 1 "$STATE")" != "intended $(intended | sha256sum | cut -d' ' -f1)" ]; then
    say "the rules in place were made for different settings (claude.network, or a user changed)"
    return 1
  fi
  expected="$(cat "$STATE")"
  live_now="$(snapshot)"
  if [ "$live_now" != "$expected" ]; then
    say "the live rules differ from the ones put in place:"
    diff <(printf '%s\n' "$expected") <(printf '%s\n' "$live_now") | grep -E '^[<>]' | head -n 10 \
      | sed 's/^</  missing:/; s/^>/  extra:  /' >&2
    return 1
  fi
}

remove_rules() {
  local ipt user
  for ipt in iptables ip6tables; do
    {
      echo "*filter"
      for user in "${USERS[@]}"; do
        "$ipt" -S "${CHAINS[$user]}" >/dev/null 2>&1 && echo ":${CHAINS[$user]} - [0:0]"
      done
      "$ipt" -S OUTPUT 2>/dev/null | grep -E -- "-j ($OUR_CHAINS)(\.new)?\$" | sed 's/^-A /-D /'
      for user in "${USERS[@]}"; do
        "$ipt" -S "${CHAINS[$user]}" >/dev/null 2>&1 && echo "-X ${CHAINS[$user]}"
      done
      echo "COMMIT"
    } | "$ipt-restore" -w 10 --noflush || { say "ERROR: couldn't remove the $ipt rules"; return 1; }
  done
  rm -f "$STATE"
}

# --- Testing that blocking works ----------------------------------------------------------------

# Does the user get through? (0 = it connected)
as_user_curl() { # user curl-args...
  local user="$1"; shift
  sudo -u "$user" curl -s --max-time 8 -o /dev/null "$@"
}
as_claude_curl() { as_user_curl claude "$@"; }

verify() {
  local failed=0 code address address6 user other result sshd_up

  for user in claude runner proxy postgres; do
    uid_of "$user" >/dev/null || continue
    if as_user_curl "$user" --noproxy '*' "http://127.0.0.1:$EDITOR_PORT/healthz"; then
      say "ERROR: the $user user can reach the editor"
      failed=1
    fi
  done

  if [ "$MODE" = "open" ]; then
    for user in claude runner; do
      uid_of "$user" >/dev/null || continue
      if timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>/dev/null \
          && sudo -u "$user" timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>/dev/null; then
        say "ERROR: the $user user can reach sshd on localhost"
        failed=1
      fi
    done
    [ "$failed" -eq 0 ] && echo "Gjöll: verified (editor and sshd blocked; open network)"
    return "$failed"
  fi

  # No DNS. The time is noted so gjoll-log can leave this test's own lookups out.
  install -d -m 0755 /var/lib/gleipnir
  { tail -n 49 "$CHECK_TIMES" 2>/dev/null; date +%s; } > "$CHECK_TIMES.new" && mv "$CHECK_TIMES.new" "$CHECK_TIMES"
  # Addresses root can reach directly, so a blocked connection really means Gjöll blocked it.
  # Connected to by address but with the site's name in the request (--resolve), since
  # hosting networks such as Cloudflare refuse a connection that doesn't name a site.
  address="$(getent ahostsv4 example.com 2>/dev/null | awk 'NR == 1 { print $1 }')"
  if [ -n "$address" ] && ! curl -s --max-time 8 -o /dev/null --noproxy '*' -k \
      --resolve "example.com:443:$address" https://example.com/; then
    address=""
  fi
  [ -n "$address" ] || say "WARNING: couldn't reach example.com over IPv4 to test direct connections"
  address6="$(getent ahostsv6 example.com 2>/dev/null | awk 'NR == 1 && $1 ~ /:/ { print $1 }')"
  if [ -n "$address6" ] && ! curl -s --max-time 8 -o /dev/null --noproxy '*' -k \
      --resolve "example.com:443:[$address6]" https://example.com/; then
    address6=""   # no IPv6 route out of this machine; the IPv6 rules are still compared by --check
  fi

  # sshd, if it's listening: a login as another user would be a way round everything
  sshd_up=no
  if timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>/dev/null; then sshd_up=yes; fi

  for user in claude runner; do
    uid_of "$user" >/dev/null || continue
    if [ "$user" = claude ]; then other="$RUNNER_PROXY_PORT"; else other="$CLAUDE_PROXY_PORT"; fi

    if [ "$sshd_up" = yes ] && sudo -u "$user" timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>/dev/null; then
      say "ERROR: the $user user can reach sshd on localhost"
      failed=1
    fi

    if sudo -u "$user" getent ahosts example.com >/dev/null 2>&1; then
      say "ERROR: the $user user can look up names (DNS isn't blocked)"
      failed=1
    fi

    # No direct connections, even to an address that works for everyone else
    if [ -n "$address" ] && as_user_curl "$user" --noproxy '*' -k --resolve "example.com:443:$address" https://example.com/; then
      say "ERROR: the $user user can connect directly to $address, bypassing the proxy"
      failed=1
    fi
    if [ -n "$address6" ] && as_user_curl "$user" --noproxy '*' -k --resolve "example.com:443:[$address6]" https://example.com/; then
      say "ERROR: the $user user can connect directly to $address6 over IPv6, bypassing the proxy"
      failed=1
    fi

    # Not the other user's proxy port, nor Squid's inner ports
    if as_user_curl "$user" --noproxy '*' "http://127.0.0.1:$other/" \
        || as_user_curl "$user" --noproxy '*' "http://127.0.0.1:3138/" \
        || as_user_curl "$user" --noproxy '*' "http://127.0.0.1:3139/"; then
      say "ERROR: the $user user can reach a proxy port that isn't its own"
      failed=1
    fi
  done

  # The dev servers' list is empty unless you add sites: the proxy refuses the rest
  if uid_of runner >/dev/null; then
    code="$(sudo -u runner curl -s --max-time 8 -o /dev/null -w '%{http_connect}' \
      -x "http://127.0.0.1:$RUNNER_PROXY_PORT" https://gleipnir-check.invalid/ 2>/dev/null)"
    case "$code" in
      403|000) ;;
      *) say "ERROR: the proxy didn't refuse the dev servers a site that isn't on their list (answered $code)"; failed=1 ;;
    esac
  fi

  # The proxy refuses sites that aren't listed. This name doesn't exist and is never looked up.
  code="$(sudo -u claude curl -s --max-time 8 -o /dev/null -w '%{http_connect}' \
    -x "http://127.0.0.1:$CLAUDE_PROXY_PORT" https://gleipnir-check.invalid/ 2>/dev/null)"
  case "$code" in
    403) ;;
    000) say "WARNING: the proxy isn't answering; Claude has no network until it does (sudo systemctl restart squid)" ;;
    *)   say "ERROR: the proxy didn't refuse a site that isn't on the list (answered $code)"; failed=1 ;;
  esac

  # And lets Anthropic through
  if [ "$code" = "403" ] && ! as_claude_curl -x "http://127.0.0.1:$CLAUDE_PROXY_PORT" https://api.anthropic.com; then
    say "WARNING: the claude user can't reach api.anthropic.com through the proxy; Claude Code may not work"
  fi

  # Package sites: decrypted, and only downloads allowed. Two uploads to npm must be refused
  # by the proxy itself (its X-Squid-Error header says so): a plain one, and one sent after
  # a CONNECT inside the decrypted connection, which would otherwise be passed through unchecked.
  if [ "$code" = "403" ]; then
    result="$(sudo -u claude python3 -I - "$CLAUDE_PROXY_PORT" "$CA_BUNDLE" <<'PY' 2>/dev/null || echo "error"
import socket, ssl, sys
port, bundle, site = int(sys.argv[1]), sys.argv[2], "registry.npmjs.org"

def head(sock):
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    return data.split(b"\r\n\r\n")[0].decode("latin-1")

def refused_by_proxy(headers):
    lines = headers.split("\r\n")
    return " 403 " in lines[0] + " " and any(l.lower().startswith("x-squid-error: err_access_denied") for l in lines)

def tunnel():
    sock = socket.create_connection(("127.0.0.1", port), timeout=15)
    sock.sendall(f"CONNECT {site}:443 HTTP/1.1\r\nHost: {site}:443\r\n\r\n".encode())
    if " 200 " not in head(sock).split("\r\n")[0] + " ":
        raise OSError("no tunnel")
    return ssl.create_default_context(cafile=bundle).wrap_socket(sock, server_hostname=site)

try:
    tls = tunnel()
    tls.sendall(f"PUT /gleipnir-upload-check HTTP/1.1\r\nHost: {site}\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{{}}".encode())
    plain = refused_by_proxy(head(tls))
    tls = tunnel()
    tls.sendall(f"CONNECT {site}:443 HTTP/1.1\r\nHost: {site}:443\r\n\r\n".encode())
    tls.settimeout(5)
    try:
        nested = refused_by_proxy(head(tls))
    except socket.timeout:
        nested = False
except (OSError, ssl.SSLError):
    print("unreachable")
    sys.exit(0)
print("ok" if plain and nested else f"upload={'refused' if plain else 'NOT refused'} nested={'refused' if nested else 'NOT refused'}")
PY
)"
    case "$result" in
      ok) ;;
      unreachable|error)
        say "WARNING: couldn't reach npm through the proxy to test that uploads are refused" ;;
      *)
        say "ERROR: the proxy didn't refuse uploads to npm ($result)"; failed=1 ;;
    esac
  fi

  [ "$failed" -eq 0 ] && echo "Gjöll: verified"
  return "$failed"
}

[ "$(id -u)" -eq 0 ] || { echo "gjoll-firewall: run it with sudo" >&2; exit 1; }

# One at a time: at boot, the dev servers' services and provisioning can all start it
exec 9>/run/gjoll-firewall.lock
flock -w 60 9 || { say "ERROR: another gjoll-firewall is still running"; exit 1; }

case "${1:-}" in
  "")        check 2>/dev/null || apply ;;
  --rebuild) apply ;;
  --remove)  remove_rules && echo "Gjöll: removed" ;;
  --check)   check ;;
  --verify)  { check 2>/dev/null || apply; } && verify ;;
  *)         echo "usage: $0 [--rebuild|--remove|--check|--verify]" >&2; exit 2 ;;
esac