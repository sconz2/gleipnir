#!/usr/bin/env bash
# Gleipnir: Gjöll, the firewall for the users that run code you didn't write.
# Everything else in the machine (provisioning, dev, the editor) is unaffected.
#
#   claude    In allowlist mode: localhost only, and its way out is its port on
#             the proxy (Squid), which checks every site by name. No DNS, so it
#             can't look names up or smuggle data out in lookups. In open mode:
#             anything, logged.
#   runner    The dev servers: the same, with a port of its own on the proxy and its
#             own list of sites (runner.allowed_domains, empty unless you add some).
#   proxy     Squid itself: HTTPS (port 443) out, and localhost, which includes
#             the machine's DNS resolver. Nothing else. (Squid decrypts the package
#             sites to check each request, so it makes those connections itself.)
#   postgres  The database server: localhost (but not the proxy), and replies to
#             connections made to it. It never needs to connect out.
#
# In every mode, claude and runner can't connect to the editor (port 8080), which
# would give them a terminal as dev.
#
#   gjoll-firewall             apply the rules if missing
#   gjoll-firewall --rebuild   remove and re-create the rules
#   gjoll-firewall --remove    remove the rules
#   gjoll-firewall --check     exit 0 only if the rules are in place
#   gjoll-firewall --verify    apply if missing, then test that blocking works
set -uo pipefail

MODE="$(cat /etc/gleipnir/claude-network 2>/dev/null || echo allowlist)"
EDITOR_PORT=8080
CLAUDE_PROXY_PORT=3128
RUNNER_PROXY_PORT=3129
# Squid's inner ports, which only Squid itself may use
INNER_PROXY_PORTS=3138,3139
# Read by gjoll-log, so this script's own DNS test isn't reported as a blocked lookup
CHECK_TIMES=/var/lib/gleipnir/dns-check-times
# The certificates claude's tools trust: the system's, plus the proxy's own for the package sites
CA_BUNDLE=/etc/gleipnir/ca-bundle.pem
# Blocked attempts are logged, but no faster than this, so a retry loop can't flood the log
LOG_LIMIT=(-m limit --limit 10/min --limit-burst 20)

# Each user Gjöll covers, and its chain
declare -A CHAINS=([claude]=GJOLL [runner]=GJOLL_RUN [proxy]=GJOLL_PROXY [postgres]=GJOLL_PG)

user_exists() { id -u "$1" >/dev/null 2>&1; }

jump_present() { # ipt user chain
  "$1" -C OUTPUT -m owner --uid-owner "$2" -j "$3" >/dev/null 2>&1
}

rules_present() {
  local ipt user
  for ipt in iptables ip6tables; do
    for user in "${!CHAINS[@]}"; do
      user_exists "$user" || continue
      jump_present "$ipt" "$user" "${CHAINS[$user]}" || return 1
    done
    # The rules that matter most: claude and runner kept out of the editor, and the final verdict
    local chain port
    for chain in GJOLL GJOLL_RUN; do
      [ "$chain" = GJOLL ] && port="$CLAUDE_PROXY_PORT" || port="$RUNNER_PROXY_PORT"
      "$ipt" -C "$chain" -p tcp --dport "$EDITOR_PORT" -j REJECT --reject-with tcp-reset >/dev/null 2>&1 || return 1
      if [ "$MODE" = "open" ]; then
        "$ipt" -C "$chain" -j ACCEPT >/dev/null 2>&1 || return 1
      else
        "$ipt" -C "$chain" -o lo -p tcp --dport "$port" -j ACCEPT >/dev/null 2>&1 || return 1
        "$ipt" -C "$chain" -j REJECT >/dev/null 2>&1 || return 1
      fi
    done
  done
}

remove_rules() {
  local ipt user chain
  for ipt in iptables ip6tables; do
    for user in "${!CHAINS[@]}"; do
      chain="${CHAINS[$user]}"
      if user_exists "$user"; then
        while "$ipt" -D OUTPUT -m owner --uid-owner "$user" -j "$chain" 2>/dev/null; do :; done
      fi
      "$ipt" -F "$chain" 2>/dev/null || true
      "$ipt" -X "$chain" 2>/dev/null || true
    done
  done
}

# A fresh, empty chain
new_chain() { # ipt chain
  "$1" -F "$2" 2>/dev/null && "$1" -X "$2" 2>/dev/null
  "$1" -N "$2"
}

# Log (rate-limited), then refuse
log_and_reject() { # ipt chain label
  "$1" -A "$2" "${LOG_LIMIT[@]}" -j LOG --log-prefix "gjoll $3 blocked: " --log-uid
  "$1" -A "$2" -j REJECT
}

# Swap a finished chain in for a user, with no moment where the user is unrestricted:
# the new chain's jump goes in first, then the old chain is removed and the new one renamed.
swap_in() { # ipt user chain
  local ipt="$1" user="$2" chain="$3"
  "$ipt" -I OUTPUT 1 -m owner --uid-owner "$user" -j "$chain.new"
  while "$ipt" -D OUTPUT -m owner --uid-owner "$user" -j "$chain" 2>/dev/null; do :; done
  "$ipt" -F "$chain" 2>/dev/null && "$ipt" -X "$chain" 2>/dev/null
  "$ipt" -E "$chain.new" "$chain"
}

# claude and runner: the same rules, each with its own port on the proxy
build_contained() { # ipt chain user own-port other-port
  local ipt="$1" c="$2" user="$3" own="$4" other="$5"
  "$ipt" -A "$c" -p tcp --dport "$EDITOR_PORT" -j REJECT --reject-with tcp-reset
  if [ "$MODE" = "open" ]; then
    "$ipt" -A "$c" -o lo -j ACCEPT
    "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    "$ipt" -A "$c" -m conntrack --ctstate NEW -j LOG --log-prefix "gjoll $user: " --log-uid
    "$ipt" -A "$c" -j ACCEPT
  else
    # No DNS, including the machine's own resolver on 127.0.0.53. Logged: it usually
    # means a tool that isn't using the proxy.
    local proto
    for proto in udp tcp; do
      "$ipt" -A "$c" -p "$proto" --dport 53 "${LOG_LIMIT[@]}" -j LOG --log-prefix "gjoll $user blocked: " --log-uid
      "$ipt" -A "$c" -p "$proto" --dport 53 -j REJECT
    done
    "$ipt" -A "$c" -o lo -p tcp --dport "$own" -j ACCEPT
    "$ipt" -A "$c" -o lo -p tcp -m multiport --dports "$other,$INNER_PROXY_PORTS" -j REJECT --reject-with tcp-reset
    # The rest of localhost: the dev servers, the database
    "$ipt" -A "$c" -o lo -j ACCEPT
    "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    log_and_reject "$ipt" "$c" "$user"
  fi
}

build_claude() { build_contained "$1" "$2" claude "$CLAUDE_PROXY_PORT" "$RUNNER_PROXY_PORT"; }
build_runner() { build_contained "$1" "$2" runner "$RUNNER_PROXY_PORT" "$CLAUDE_PROXY_PORT"; }

build_proxy() { # ipt chain
  local ipt="$1" c="$2"
  "$ipt" -A "$c" -p tcp --dport "$EDITOR_PORT" -j REJECT --reject-with tcp-reset
  "$ipt" -A "$c" -o lo -j ACCEPT
  "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  "$ipt" -A "$c" -p tcp --dport 443 -j ACCEPT
  log_and_reject "$ipt" "$c" proxy
}

build_postgres() { # ipt chain
  local ipt="$1" c="$2"
  # Not the proxy either: the database never needs to reach a website
  "$ipt" -A "$c" -o lo -p tcp -m multiport --dports "$CLAUDE_PROXY_PORT,$RUNNER_PROXY_PORT,$INNER_PROXY_PORTS" -j REJECT --reject-with tcp-reset
  "$ipt" -A "$c" -o lo -j ACCEPT
  # Replies to connections made to it, including your computer's through the forwarded port
  "$ipt" -A "$c" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  log_and_reject "$ipt" "$c" postgres
}

# Each chain is built complete, ending in a verdict, before it's swapped in
build_rules() {
  local ipt user chain
  for ipt in iptables ip6tables; do
    for user in claude runner proxy postgres; do
      user_exists "$user" || continue
      chain="${CHAINS[$user]}"
      new_chain "$ipt" "$chain.new"
      "build_$user" "$ipt" "$chain.new"
      swap_in "$ipt" "$user" "$chain"
    done
  done
  # Left over from the version that allowed sites by address
  if command -v ipset >/dev/null 2>&1; then
    ipset destroy gjoll-allowed 2>/dev/null || true
    ipset destroy gjoll-allowed-new 2>/dev/null || true
  fi
}

# Does the user get through? (0 = it connected)
as_user_curl() { # user curl-args...
  local user="$1"; shift
  sudo -u "$user" curl -s --max-time 8 -o /dev/null "$@"
}
as_claude_curl() { as_user_curl claude "$@"; }

verify() {
  local failed=0 code address user own other

  for user in claude runner; do
    user_exists "$user" || continue
    if as_user_curl "$user" --noproxy '*' "http://127.0.0.1:$EDITOR_PORT/healthz"; then
      echo "Gjöll: ERROR: the $user user can reach the editor" >&2
      failed=1
    fi
  done

  if [ "$MODE" = "open" ]; then
    [ "$failed" -eq 0 ] && echo "Gjöll: verified (editor blocked; open network)"
    return "$failed"
  fi

  # No DNS. The time is noted so gjoll-log can leave this test's own lookups out.
  install -d -m 0755 /var/lib/gleipnir
  { tail -n 49 "$CHECK_TIMES" 2>/dev/null; date +%s; } > "$CHECK_TIMES.new" && mv "$CHECK_TIMES.new" "$CHECK_TIMES"
  address="$(getent ahostsv4 example.com 2>/dev/null | awk 'NR == 1 { print $1 }')"
  [ -n "$address" ] || echo "Gjöll: WARNING: couldn't look up example.com to test direct connections" >&2
  for user in claude runner; do
    user_exists "$user" || continue
    if [ "$user" = claude ]; then own="$CLAUDE_PROXY_PORT" other="$RUNNER_PROXY_PORT"; else own="$RUNNER_PROXY_PORT" other="$CLAUDE_PROXY_PORT"; fi

    if sudo -u "$user" getent ahosts example.com >/dev/null 2>&1; then
      echo "Gjöll: ERROR: the $user user can look up names (DNS isn't blocked)" >&2
      failed=1
    fi

    # No direct connections, even to an address that works for everyone else
    if [ -n "$address" ] && as_user_curl "$user" --noproxy '*' -k "https://$address/"; then
      echo "Gjöll: ERROR: the $user user can connect directly to $address, bypassing the proxy" >&2
      failed=1
    fi

    # Not the other user's proxy port, nor Squid's inner ports
    if as_user_curl "$user" --noproxy '*' "http://127.0.0.1:$other/" \
        || as_user_curl "$user" --noproxy '*' "http://127.0.0.1:3138/" \
        || as_user_curl "$user" --noproxy '*' "http://127.0.0.1:3139/"; then
      echo "Gjöll: ERROR: the $user user can reach a proxy port that isn't its own" >&2
      failed=1
    fi
  done

  # The dev servers' list is empty unless you add sites: the proxy refuses the rest
  if user_exists runner; then
    code="$(sudo -u runner curl -s --max-time 8 -o /dev/null -w '%{http_connect}' \
      -x "http://127.0.0.1:$RUNNER_PROXY_PORT" https://gleipnir-check.invalid/ 2>/dev/null)"
    case "$code" in
      403|000) ;;
      *) echo "Gjöll: ERROR: the proxy didn't refuse the dev servers a site that isn't on their list (answered $code)" >&2; failed=1 ;;
    esac
  fi

  # The proxy refuses sites that aren't listed. This name doesn't exist and is never looked up.
  code="$(sudo -u claude curl -s --max-time 8 -o /dev/null -w '%{http_connect}' \
    -x "http://127.0.0.1:$CLAUDE_PROXY_PORT" https://gleipnir-check.invalid/ 2>/dev/null)"
  case "$code" in
    403) ;;
    000) echo "Gjöll: WARNING: the proxy isn't answering; Claude has no network until it does (sudo systemctl restart squid)" >&2 ;;
    *)   echo "Gjöll: ERROR: the proxy didn't refuse a site that isn't on the list (answered $code)" >&2; failed=1 ;;
  esac

  # And lets Anthropic through
  if [ "$code" = "403" ] && ! as_claude_curl -x "http://127.0.0.1:$CLAUDE_PROXY_PORT" https://api.anthropic.com; then
    echo "Gjöll: WARNING: the claude user can't reach api.anthropic.com through the proxy; Claude Code may not work" >&2
  fi

  # Package sites: decrypted, and only downloads allowed. Two uploads to npm must be refused
  # by the proxy itself (its X-Squid-Error header says so): a plain one, and one sent after
  # a CONNECT inside the decrypted connection, which would otherwise be passed through unchecked.
  if [ "$code" = "403" ]; then
    result="$(sudo -u claude python3 -I - "$CLAUDE_PROXY_PORT" "$CA_BUNDLE" <<'PY' 2>/dev/null || echo "error"
import socket, ssl, sys
port, bundle, site = int(sys.argv[1]), sys.argv[2], "registry.npmjs.org"

def head(sock):
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = sock.recv(4096)
        if not chunk:
            break
        data += chunk
    return data.split(b"\r\n\r\n")[0].decode("latin-1")

def refused_by_proxy(headers):
    lines = headers.split("\r\n")
    return " 403 " in lines[0] + " " and any(l.lower().startswith("x-squid-error: err_access_denied") for l in lines)

def tunnel():
    sock = socket.create_connection(("127.0.0.1", port), timeout=15)
    sock.sendall(f"CONNECT {site}:443 HTTP/1.1\r\nHost: {site}:443\r\n\r\n".encode())
    if " 200 " not in head(sock).split("\r\n")[0] + " ":
        raise OSError("no tunnel")
    return ssl.create_default_context(cafile=bundle).wrap_socket(sock, server_hostname=site)

try:
    tls = tunnel()
    tls.sendall(f"PUT /gleipnir-upload-check HTTP/1.1\r\nHost: {site}\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{{}}".encode())
    plain = refused_by_proxy(head(tls))
    tls = tunnel()
    tls.sendall(f"CONNECT {site}:443 HTTP/1.1\r\nHost: {site}:443\r\n\r\n".encode())
    tls.settimeout(5)
    try:
        nested = refused_by_proxy(head(tls))
    except socket.timeout:
        nested = False
except (OSError, ssl.SSLError):
    print("unreachable")
    sys.exit(0)
print("ok" if plain and nested else f"upload={'refused' if plain else 'NOT refused'} nested={'refused' if nested else 'NOT refused'}")
PY
)"
    case "$result" in
      ok) ;;
      unreachable|error)
        echo "Gjöll: WARNING: couldn't reach npm through the proxy to test that uploads are refused" >&2 ;;
      *)
        echo "Gjöll: ERROR: the proxy didn't refuse uploads to npm ($result)" >&2; failed=1 ;;
    esac
  fi

  [ "$failed" -eq 0 ] && echo "Gjöll: verified"
  return "$failed"
}

case "${1:-}" in
  "")        rules_present || build_rules ;;
  --rebuild) build_rules ;;
  --remove)  remove_rules; echo "Gjöll: removed" ;;
  --check)   rules_present ;;
  --verify)  rules_present || build_rules; verify ;;
  *)         echo "usage: $0 [--rebuild|--remove|--check|--verify]" >&2; exit 2 ;;
esac