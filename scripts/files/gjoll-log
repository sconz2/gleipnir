#!/usr/bin/env python3
"""Gleipnir: what Gjöll blocked. Reads the proxy's log and the kernel's firewall log.

  sudo gjoll-log                   the last 24 hours
  sudo gjoll-log --since 2h        or 30m, 3d, or a Unix time (@1793223414)
  sudo gjoll-log --user claude     one user only

Three kinds of block:
  refused by the proxy     the site isn't on that user's list
  wrong name in the hello  the tool asked for an allowed site, then named another
  direct connection        something tried to go round the proxy (or used DNS)
"""
import argparse
import os
import re
import subprocess
import sys
import time
from collections import Counter

SQUID_LOG = "/var/log/squid/access.log"
LISTS = {"claude": "/etc/squid/gleipnir/claude-domains", "runner": "/etc/squid/gleipnir/runner-domains"}
OUTER = {"3128": "claude", "3129": "runner"}
INNER = {"3138": "claude", "3139": "runner"}
KERNEL_LINE = re.compile(r"gjoll (\S+) blocked: ")


def field(line, name):
    match = re.search(rf"\b{name}=(\S+)", line)
    return match.group(1) if match else None


def parse_since(text):
    if text.startswith("@"):
        return float(text[1:])
    match = re.fullmatch(r"(\d+)([mhd])", text)
    if not match:
        sys.exit(f"gjoll-log: --since takes 30m, 2h, 3d or @<unix time>, not {text!r}")
    return time.time() - int(match.group(1)) * {"m": 60, "h": 3600, "d": 86400}[match.group(2)]


def load_list(path):
    exact, suffixes = set(), set()
    try:
        with open(path) as fh:
            for line in fh:
                line = line.strip().lower()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("."):
                    suffixes.add(line[1:])
                else:
                    exact.add(line)
    except OSError:
        pass
    return exact, suffixes


def allowed(name, rules):
    exact, suffixes = rules
    name = name.lower().rstrip(".")
    return name in exact or any(name == s or name.endswith("." + s) for s in suffixes)


def squid_blocks(path, since, lists):
    refused, wrong_hello = Counter(), Counter()
    for log in (path + ".1", path):
        try:
            fh = open(log, errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                # time, port, asked for, hello name, status, result
                parts = line.split()
                if len(parts) < 6:
                    continue
                try:
                    when = float(parts[0])
                except ValueError:
                    continue
                if when < since:
                    continue
                port, asked, hello, result = parts[1], parts[2], parts[3], parts[5]
                if port in OUTER and result == "TCP_DENIED":
                    refused[(OUTER[port], asked)] += 1
                elif port in INNER and hello != "-":
                    user = INNER[port]
                    if not allowed(hello, lists[user]):
                        host = asked.rsplit(":", 1)[0]
                        wrong_hello[(user, f"{hello} (asked for {host})")] += 1
    return refused, wrong_hello


def kernel_lines(since, path):
    if path:
        try:
            with open(path, errors="replace") as fh:
                return fh.read().splitlines()
        except OSError:
            return []
    try:
        out = subprocess.run(
            ["journalctl", "-k", "--no-pager", "-o", "cat", "--since", f"@{int(since)}", "--grep", "gjoll .* blocked"],
            capture_output=True, text=True, timeout=30)
        return out.stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return []


def kernel_blocks(since, path):
    direct = Counter()
    for line in kernel_lines(since, path):
        match = KERNEL_LINE.search(line)
        if not match:
            continue
        user = match.group(1)
        dst, proto, dport = field(line, "DST"), field(line, "PROTO"), field(line, "DPT")
        if dport == "53":
            what = f"DNS lookup via {dst}"
        else:
            what = f"{dst}:{dport or '?'}" + (f" ({proto})" if proto and proto != "TCP" else "")
        direct[(user, what)] += 1
    return direct


def section(title, counts, user, limit):
    out = []
    by_user = {}
    for (who, what), n in counts.items():
        if user in (None, who):
            by_user.setdefault(who, []).append((what, n))
    for who in sorted(by_user):
        items = sorted(by_user[who], key=lambda row: (-row[1], row[0]))
        out.append(f"  {who}: {title}")
        for what, n in items[:limit]:
            out.append(f"    {n:>5}x  {what}")
        if len(items) > limit:
            out.append(f"           ...and {len(items) - limit} more (sudo gjoll-log)")
    return out


def main():
    parser = argparse.ArgumentParser(description="What Gjöll blocked.")
    parser.add_argument("--since", default="24h")
    parser.add_argument("--user")
    parser.add_argument("--brief", action="store_true", help="at most 10 of each, for the end of a session")
    parser.add_argument("--squid-log", default=SQUID_LOG, help=argparse.SUPPRESS)
    parser.add_argument("--kernel-log", help=argparse.SUPPRESS)
    args = parser.parse_args()

    if os.geteuid() != 0 and not args.kernel_log:
        sys.exit("gjoll-log: run it with sudo")

    since = parse_since(args.since)
    lists = {user: load_list(path) for user, path in LISTS.items()}
    refused, wrong_hello = squid_blocks(args.squid_log, since, lists)
    direct = kernel_blocks(since, args.kernel_log)
    limit = 10 if args.brief else 1000

    lines = []
    lines += section("refused by the proxy (not on its list)", refused, args.user, limit)
    lines += section("cut: the hello named a different site", wrong_hello, args.user, limit)
    lines += section("blocked going round the proxy", direct, args.user, limit)

    started = time.strftime("%Y-%m-%d %H:%M", time.localtime(since))
    if lines:
        print(f"Gjöll: blocked since {started}")
        print("\n".join(lines))
        print("To allow a site, add it to claude.allowed_domains and provision. Names you don't recognise are worth a look.")
    else:
        print(f"Gjöll: nothing blocked since {started}")


if __name__ == "__main__":
    main()