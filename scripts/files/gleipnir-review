#!/usr/bin/env bash
# Gleipnir: bring Claude's work into your copy of the project, for you to review and merge.
# A wip/ branch of Claude's arrives in your copy (/srv/project) under the same name; any
# other branch arrives as incoming/<name>, so nothing of yours (main) can be replaced.
#
# A branch in your copy is only ever moved forward. If you've added commits of your own to
# a wip/ branch and Claude's version no longer contains them, Claude's arrives beside yours
# as incoming/wip/<name> instead, and yours is left alone. The incoming/ branches are
# Claude's mirror, replaced whenever its branch changes, so don't commit on those. (No
# branch name here says where it came from: merge messages and pushed branches are yours.)
#
#   sudo gleipnir-review             Claude's current branch
#   sudo gleipnir-review wip/<date>  a branch you name
#
# Only data moves between the two copies: claude writes a git bundle of the branch, and dev
# reads it, checking every object. Nothing of Claude's (hooks, git settings, scripts) runs as
# dev. Heimdall then checks what the branch itself changes, which is what you'd merge.
# The claude command does all this for you when a session ends.
set -euo pipefail

TRUSTED=/srv/project
WORK=/srv/work
LOCK=/run/lock/gleipnir-review
# Claude's branch lands here first; it's only made a branch of yours once it's all arrived and
# nothing of yours would be lost
INCOMING=refs/gleipnir/incoming

[ "$(id -u)" -eq 0 ] || { echo "gleipnir-review: run it with sudo" >&2; exit 1; }
if [ ! -d "$TRUSTED/.git" ] || [ ! -d "$WORK/.git" ]; then
  echo "Gleipnir: the project isn't set up yet; provision first." >&2
  exit 1
fi

# Claude's own hooks and git settings aren't needed for this, so they're switched off. Those
# in its .git/config (filters, say) can't all be, so each command gets a time limit: a
# setting that would hang only hangs itself. Set CLAUDE_GIT_SECONDS for the slow ones.
as_claude() {
  local limit="${CLAUDE_GIT_SECONDS:-60}" rc=0
  timeout -k 5 "$limit" sudo -u claude -H git -C "$WORK" -c core.fsmonitor=false -c core.hooksPath=/dev/null "$@" || rc=$?
  if [ "$rc" -eq 124 ]; then
    echo "Gleipnir: git in Claude's copy didn't finish within ${limit}s (git $1); something in Claude's git settings may be hanging it." >&2
  fi
  return "$rc"
}
as_dev() { sudo -u dev -H git -C "$TRUSTED" "$@"; }

# One at a time: the claude command runs this as a session ends, and you may run greview
[ -d "$(dirname "$LOCK")" ] || mkdir -p "$(dirname "$LOCK")"
exec 9>"$LOCK"
if ! flock -w 120 9; then
  echo "Gleipnir: another gleipnir-review is still running; try again in a moment." >&2
  exit 1
fi

branch="${1:-}"
if [ -z "$branch" ]; then
  branch="$(as_claude symbolic-ref --short -q HEAD || true)"
fi
# Plain branch names only
if ! [[ "$branch" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$ ]] \
    || [[ "$branch" == *..* ]] || [[ "$branch" == *.lock ]] || [[ "$branch" == *.lock/* ]] \
    || ! git check-ref-format "refs/heads/$branch"; then
  echo "Gleipnir: Claude's copy isn't on a branch it can bring across (\"${branch:-no branch}\"); name one, e.g. sudo gleipnir-review wip/2026-10-29" >&2
  exit 1
fi
case "$branch" in
  wip/*) dest="$branch" ;;
  *)     dest="incoming/$branch" ;;
esac

# Changes Claude hasn't committed stay behind; say so
uncommitted="$(as_claude status --porcelain --untracked-files=normal 2>/dev/null | wc -l || true)"
note_uncommitted() {
  if [ "${uncommitted:-0}" -gt 0 ]; then
    echo "  Claude's copy also has $uncommitted uncommitted change(s), which stay there. Ask Claude to commit them to bring them across."
  fi
}

tip="$(as_claude rev-parse --verify --quiet "refs/heads/$branch^{commit}" || true)"
if [ -z "$tip" ]; then
  echo "Gleipnir: $branch has no commits in Claude's copy yet; nothing to bring across."
  note_uncommitted
  exit 0
fi
checked_out() { [ "$(as_dev symbolic-ref --short -q HEAD || true)" = "$1" ]; }
if checked_out "$dest"; then
  echo "Gleipnir: your copy has $dest checked out, so it can't be updated. Switch to main first: git switch main" >&2
  exit 1
fi

# The bundle is written by root, from git's output, into root's own folder: Claude can't swap
# it for something else before dev reads it. Whatever happens, the holding reference goes.
stage="$(mktemp -d)"
cleanup() {
  rm -rf "$stage"
  as_dev update-ref -d "$INCOMING" >/dev/null 2>&1 || true
}
trap cleanup EXIT
chmod 0755 "$stage"

if as_dev cat-file -e "$tip^{commit}" 2>/dev/null; then
  # Your copy already has every commit of it (brought across before, or made by you)
  new="$tip"
else
  # Room for it, settled before anything is written: the bundle is cut off at a third of the
  # free disk space, so a branch full of huge files can't fill the disk your copy is on
  free="$(df --output=avail -B1 "$TRUSTED" | tail -n 1)"
  stage_free="$(df --output=avail -B1 "$stage" | tail -n 1)"
  [ "$stage_free" -lt "$free" ] && free="$stage_free"
  limit=$((free / 3))

  # Only what your copy doesn't have yet: your branch tips that Claude's copy also has are
  # left out of the bundle. (Claude's copy gains nothing by claiming to have one: a bundle
  # that then lacks objects is refused on arrival.)
  basis=()
  while IFS= read -r line; do
    case "$line" in *" commit "*) basis+=("^${line%% *}") ;; esac
  done < <(as_dev for-each-ref --format='%(objectname)' refs/heads/ | as_claude cat-file --batch-check 2>/dev/null || true)

  set +e
  CLAUDE_GIT_SECONDS=600 as_claude bundle create --quiet - "refs/heads/$branch" "${basis[@]}" 2>"$stage/bundle.err" \
    | head -c $((limit + 1)) > "$stage/work.bundle"
  bundled=${PIPESTATUS[0]}
  set -e
  chmod 0644 "$stage/work.bundle"
  size="$(stat -c %s "$stage/work.bundle")"
  if [ "$size" -gt "$limit" ]; then
    echo "Gleipnir: Claude's branch is more than $((limit / 1048576)) MB packed, and your copy's disk has only $((free / 1048576)) MB free; nothing was changed." >&2
    echo "  Ask Claude what it added, and to take the big files out of the branch (git rm, then commit)." >&2
    exit 1
  fi
  if [ "$bundled" -ne 0 ]; then
    tail -n 5 "$stage/bundle.err" >&2
    echo "Gleipnir: Claude's branch couldn't be bundled; nothing was changed." >&2
    exit 1
  fi
  if [ "$size" -gt $((500 * 1048576)) ]; then
    echo "Gleipnir: Claude's branch is big ($((size / 1048576)) MB packed); look for large files it added."
  fi

  as_dev -c transfer.fsckObjects=true -c fetch.fsckObjects=true \
    fetch --quiet --no-tags --no-write-fetch-head "$stage/work.bundle" "+refs/heads/$branch:$INCOMING" \
    || { echo "Gleipnir: Claude's branch didn't arrive in one piece; nothing was changed." >&2; exit 1; }
  new="$(as_dev rev-parse --verify --quiet "$INCOMING^{commit}" || true)"
  if [ -z "$new" ]; then
    echo "Gleipnir: Claude's branch didn't arrive in one piece; nothing was changed." >&2
    exit 1
  fi

  # Packed, a branch can be small and still unpack to a full disk when you look at it: a file
  # of repeated bytes, say. Measure what arrived unpacked, before it becomes a branch of yours.
  unpacked="$(as_dev rev-list --objects "$INCOMING" --not --branches --tags --remotes \
    | cut -d' ' -f1 | as_dev cat-file --batch-check='%(objectsize)' | awk '{ s += $1 } END { print s + 0 }')"
  if [ $((unpacked * 2)) -gt "$free" ]; then
    echo "Gleipnir: Claude's branch adds $((unpacked / 1048576)) MB of files unpacked ($((size / 1048576)) MB packed), and your copy's disk has only $((free / 1048576)) MB free; nothing was changed." >&2
    echo "  Ask Claude what it added, and to take the big files out of the branch (git rm, then commit)." >&2
    echo "  What arrived is still in your copy's object store; to drop it: sudo -u dev git -C $TRUSTED gc --prune=now" >&2
    exit 1
  fi
fi

tip_of() { as_dev rev-parse --verify --quiet "refs/heads/$1^{commit}" || true; }
current="$(tip_of "$dest")"
if [ -n "$current" ] && ! as_dev merge-base --is-ancestor "$current" "$new"; then
  case "$dest" in
    incoming/*) ;;   # Claude's mirror: replaced
    *)
      echo "Gleipnir: your $dest has commits that Claude's doesn't, so it's left as it is."
      dest="incoming/$dest"
      current="$(tip_of "$dest")"
      echo "  Claude's version is in your copy as $dest instead. Compare them: git log --oneline --graph $dest ${dest#incoming/}"
      ;;
  esac
fi
if [ "$current" = "$new" ]; then
  echo "Gleipnir: your copy's $dest already has all of Claude's $branch; nothing new."
  note_uncommitted
  exit 0
fi
if checked_out "$dest"; then
  echo "Gleipnir: your copy has $dest checked out, so it can't be updated. Switch to main first: git switch main" >&2
  exit 1
fi
# Git can't have a branch both above and below another (a/b beside a), so a name of yours
# can be in the way of a new one
if [ -z "$current" ]; then
  above="$dest"
  while [[ "$above" == */* ]]; do
    above="${above%/*}"
    if [ -n "$(tip_of "$above")" ]; then
      echo "Gleipnir: your copy has a branch called $above, which is in the way of making $dest (git can't have both)." >&2
      echo "  Rename yours (git branch -m $above <new name>) or ask Claude to rename its branch, then run it again." >&2
      exit 1
    fi
  done
  below="$(as_dev for-each-ref --count=1 --format='%(refname:short)' "refs/heads/$dest/")"
  if [ -n "$below" ]; then
    echo "Gleipnir: your copy has a branch called $below, which is in the way of making $dest (git can't have both)." >&2
    echo "  Rename yours (git branch -m $below <new name>) or ask Claude to rename its branch, then run it again." >&2
    exit 1
  fi
fi
# Moved only from the value just checked: if the branch changed under this, nothing is lost
zero="$(printf '%*s' "${#new}" '' | tr ' ' 0)"
if ! as_dev update-ref "refs/heads/$dest" "$new" "${current:-$zero}" 2>/dev/null; then
  echo "Gleipnir: your copy's $dest changed while this ran; nothing was changed. Run it again." >&2
  exit 1
fi
as_dev update-ref -d "$INCOMING" >/dev/null 2>&1 || true

# What arrived, compared with the branch you're on (usually main)
base="$(as_dev symbolic-ref --short -q HEAD || true)"
if [ -n "$base" ] && ! as_dev rev-parse --verify --quiet "refs/heads/$base^{commit}" >/dev/null; then
  base=""
fi
if [ -n "$base" ] && ! as_dev merge-base "$base" "$dest" >/dev/null; then
  echo "Gleipnir: Claude's work is in your copy as $dest, but it has no history in common with $base."
  echo "  Look through it with: git log $dest"
elif [ -n "$base" ]; then
  commits="$(as_dev rev-list --count "$base..$dest")"
  files="$(as_dev diff --name-only "$base...$dest" | wc -l)"
  echo "Gleipnir: Claude's work is in your copy as $dest: $commits commit(s), $files file(s) changed since $base."
  echo "  Review:  git diff $base...$dest"
  echo "  Merge:   git merge --squash $dest, then git commit"
else
  echo "Gleipnir: Claude's work is in your copy as $dest."
  echo "  Your copy has no commits of its own yet. To make it your main branch: git switch -c main $dest"
fi
note_uncommitted

# Heimdall, on the branch's commits, in your copy
if [ -f /etc/gleipnir/heimdall ]; then
  echo
  timeout 120 sudo -u dev -H /usr/local/bin/heimdall-check --review "$TRUSTED" "${base:+refs/heads/$base}" "refs/heads/$dest" \
    || echo "Heimdall: the check didn't finish; review the branch's changes by hand"
fi