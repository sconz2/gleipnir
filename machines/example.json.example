{
  "repo": "git@github.com:your-username/your-project.git",
  "deploy_key": "keys/my-project",
  "env_file": "env/my-project.env",
  "git": { "name": "Your Name", "email": "you@example.com" },
  "vm": { "memory": 4096, "cpus": 2 },
  "ports": { "editor": 8080, "app": 5173, "db": 54320 },
  "node": 24,
  "postgres": {
    "enabled": false,
    "version": 18,
    "user": "app",
    "password": "change-me",
    "databases": ["my_project"]
  },
  "claude": {
    "network": "allowlist",
    "allowed_domains": [],
    "autocommit": true,
    "checks": true
  }
}